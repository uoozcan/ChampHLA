// WGS-specific resource fixes for Puhti scratch.
//
// BAM_TO_FASTQ: each WGS BAM (~12-34 GB) produces ~30-80 GB of paired FASTQs;
//   running 5 in parallel fills the 1 TB scratch. maxForks = 4 allows more
//   parallelism now that venex WGS runs use EXTRACT_HLA_AND_CONVERT instead
//   (HLA-region-only, <1 GB per sample).
//
// OPTITYPE: BAM pipeline (extract_hla_region=true) produces ~200-500 MB HLA-region
//   FASTQs — 32 GB is sufficient. FASTQ pipeline passes full WGS FASTQs (~7-14 GB
//   compressed) to OptiType's Razers3 pre-filter, which needs more memory.
//   Retry logic: 64 GB first attempt, 128 GB on retry (covers FASTQs up to ~14 GB).
//   errorStrategy 'ignore' in the module suppresses retries; override it here so
//   SLURM OOM kills (exit != 1) trigger a retry at higher memory, while genuine
//   OptiType failures (exit 1) are still silently ignored.
process {
    withName: BAM_TO_FASTQ {
        maxForks = 4
    }
    withName: 'OPTITYPE|OPTITYPE_FASTQ' {
        // Keep this override self-contained: helper methods defined in the main
        // config are not available when this file is loaded as an extra config.
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'retry' }
        maxRetries    = 1
        memory        = { task.attempt == 1 ? 64.GB : 128.GB }
        cpus          = 8
    }
}

{
  "schema_version": "champhla-confirmation-protocol-1",
  "status": "frozen_before_external_truth",
  "primary_baseline": "SimpleTwoThirdsConsensus",
  "primary_method": "TwoThirdsGuardedCC",
  "endpoint": "fixed-denominator exact unordered two-field correctness",
  "genes": ["A", "B", "C"],
  "modalities": ["wgs", "wes", "rnaseq"],
  "panels": {
    "wgs": ["HLA-HD", "Kourami", "OptiType", "SpecHLA", "T1K"],
    "wes": ["HLA-HD", "OptiType", "POLYSOLVER", "SpecHLA", "T1K"],
    "rnaseq": ["ArcasHLA", "HLA-HD", "OptiType", "T1K"]
  },
  "baseline_rule": "one unweighted exact-pair vote per callable intended-use caller; call at support >= 2/3; otherwise no_consensus",
  "guarded_cc_rule": "preserve callable SimpleTwoThirdsConsensus; otherwise raw ChampionChallenger; deterministic plurality only if raw CC is missing",
  "always_emit_guarded_cc": true,
  "external_freeze_no_evidence_policy": "reject freeze if any Guarded CC locus is not callable",
  "homozygosity_guard_primary": false,
  "imgt_hla_version": "3.59.0",
  "genome_reference": "GRCh38DH",
  "bootstrap_iterations": 100000,
  "permutation_iterations": 1000000,
  "random_seed": 20260831,
  "primary_multiplicity": "Holm across WGS, WES, RNA-seq",
  "retention": {
    "all_primary_holm_significant": true,
    "all_primary_delta_positive": true,
    "all_primary_cluster_ci_lower_above_zero": true,
    "max_plurality_regression_points": 2.0,
    "no_holm_significant_per_gene_harm": true
  },
  "external_sample_targets": {
    "wgs_minimum": 120,
    "wgs_maximum": 180,
    "wes_minimum": 89,
    "wes_maximum": 120,
    "rnaseq_minimum": 130,
    "rnaseq_target": 150,
    "rnaseq_maximum": 200
  },
  "claim_boundary": "resolves consensus failures while preserving high-agreement calls; does not claim higher conditional accuracy on baseline-called loci"
}

  "input_retention_policy": {
    "schema_note": "Set 2026-09-10 to make the production run fit the project allocation.",
    "wgs": {
      "staging": "streamed",
      "source_retained": false,
      "detail": "The source CRAM is read over HTTPS and never written to disk; only the mate-aware HLA BAM the callers consume is kept. samtools 1.21 is built with libcurl=yes S3=yes GCS=yes and plugins=no, so the handlers are compiled in and HTS_PATH is not required.",
      "verification_caveat": "Because the CRAM is never on disk its source_checksum cannot be independently reverified. Each sample records the declared checksum, the verified index checksum and the extracted BAM checksum in streamed_source.json."
    },
    "wes": {
      "staging": "downloaded_and_verified",
      "source_retained_until": "validation",
      "detail": "WES callers consume the CRAM itself, so it cannot be replaced by an extract without changing what every WES caller sees. It is verified on arrival and released after CALLERS_COMPLETE and output validation."
    },
    "rnaseq": {
      "staging": "downloaded_and_verified",
      "source_retained_until": "validation",
      "detail": "Same as WES; the callers consume the FASTQ pair directly."
    },
    "recoverability": "Every released input remains re-derivable: the frozen manifest pins input_uri, source_checksum and index_checksum, and staged_files_sha256.txt is retained for each sample.",
    "never_released": [
      "WGS mate-aware HLA BAM",
      "native caller outputs",
      "prediction evidence and checksum records",
      "logs"
    ]
  }

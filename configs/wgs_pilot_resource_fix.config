// Isolated confirmation-pilot overrides. The production pipeline is read-only.
// Failures must not be converted into apparently complete five-caller panels.
process {
    withName: KOURAMI {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
        maxRetries = 2
        cpus = 8
        memory = { task.attempt == 1 ? 64.GB : 128.GB }
        time = 8.h
    }
}
